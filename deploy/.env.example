# Copia este archivo como deploy/.env y cambia ambos secretos antes de publicar.
# En el servidor usa valores aleatorios largos; este archivo no debe contener
# secretos reales ni subirse al repositorio.
HOST_PORT=8080
POSTGRES_PASSWORD=REEMPLAZA_ESTO_POR_UN_SECRETO_LARGO
REDIS_PASSWORD=REEMPLAZA_ESTO_POR_OTRO_SECRETO_LARGO
